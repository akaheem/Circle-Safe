# Copy to .env.local. Leave both unset to run the app in demo mode (in-memory mock backend).

# Sub0 base URL — endpoints are called as POST $NEXT_PUBLIC_API_URL/<resource>
NEXT_PUBLIC_API_URL=

# Sub0 WebSocket endpoint for live dashboard updates, e.g. wss://<sub0-host>/ws
# Requires ALLOW_WEBSOCKET_CONNECTIONS=true on the Sub0 side.
NEXT_PUBLIC_WS_URL=
