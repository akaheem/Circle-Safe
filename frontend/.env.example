# Copy to .env.local — overrides the default demo with a real backend.
#
# ⚠️ BUILD-TIME WARNING: NEXT_PUBLIC_* vars are inlined at BUILD time. If you
# set them on a deployed service after the build, they do NOTHING. The app
# silently keeps serving the in-memory demo. Check the header badge — "Demo"
# means it missed the build. Set the var, rebuild, redeploy.

# ── Mode 1: self-hosted Postgres (recommended for real use) ───────────────
# The API in app/api/[resource] executes the same SQL against your Postgres.
# NEXT_PUBLIC_LOCAL_API=true
# DATABASE_URL=postgres://user:password@host:5432/circlesafe?sslmode=require
# JWT_SECRET_KEY=           # 48+ random chars: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# DATABASE_SSL=true         # only if the URL has no sslmode parameter
# DATABASE_POOL_MAX=5       # keep small on free tiers
# JWT_EXPIRES_IN=7d

# ── Mode 2: demo (default when nothing is set) ───────────────────────────
# Leave everything above unset. The app runs against an in-memory mock; every
# flow is clickable, no database needed. Passwords are really checked against
# a list held in this browser tab — close it and everything resets, including
# your account. The login screen shows the seeded demo credentials.
# ⚠️ This is NOT a security hole — it is the demo mode. It is also NOT where
# you want real users landing (set NEXT_PUBLIC_LOCAL_API to stop that).

# ── Mode 3: live Sub0 (the hackathon target, see DEPLOYMENT.md) ───────────
# Takes precedence over mode 1 if set.
# NEXT_PUBLIC_API_URL=https://<your-sub0-host>
# NEXT_PUBLIC_WS_URL=wss://<your-sub0-host>/ws

# ── Google Sign-In (OAuth 2.0) ─────────────────────────────────────────
# 1. Create a project at https://console.cloud.google.com
# 2. Configure the OAuth consent screen (External, add your email as test user)
# 3. Create OAuth 2.0 Client ID (Web application)
# 4. Add authorized redirect URIs (e.g., http://localhost:3000)
# 5. Set both vars below (NEXT_PUBLIC_ prefix = visible to browser, which is
#    normal for OAuth client IDs — they are not secrets)
# GOOGLE_CLIENT_ID=1234567890-xxxxx.apps.googleusercontent.com
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=1234567890-xxxxx.apps.googleusercontent.com

# ── WhatsApp OTP (optional — dev mode logs OTP to console) ──────────────
# Set these to send OTPs via a WhatsApp Business API provider.
# WHATSAPP_API_URL=https://your-whatsapp-api-endpoint
# WHATSAPP_API_KEY=your-api-key

# ── Email (invitations, join requests, circle notifications) ──────────────
# Without SMTP nothing breaks: every message is written to the _emails outbox
# and printed to the server console, and the API returns the invite link
# directly so you can send it by hand. Admin → Emails shows the outbox.
# APP_URL=http://localhost:3000        # required when SMTP IS configured
# MAIL_FROM=CircleSafe <no-reply@yourdomain>
# SMTP_URL=smtps://user:pass@smtp.example.com:465
#   ...or the individual settings instead of SMTP_URL:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=                 # Gmail: an App Password, never your account password
# SMTP_SECURE=false          # true for port 465

# ── Accounts ──────────────────────────────────────────────────────────────
# Comma-separated addresses that become platform ADMINs on sign-up. The role
# is also reconciled at sign-in, so an existing account is promoted the next
# time the listed address logs in.
# ADMIN_EMAILS=you@example.com
