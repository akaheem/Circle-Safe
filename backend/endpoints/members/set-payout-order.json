{
  "id": "circlesafe-set-payout-order-01",
  "resource": "set-payout-order",
  "tokenize": { "type": "JWT", "algorithm": "HS256", "encryption_key": "$ENV.JWT_SECRET_KEY" },
  "protected": { "provide_as": "Authorization", "extract_claims": ["id"] },
  "actionables": [
    {
      "id": 1,
      "mode": "QUERY",
      "payload_validation": [
        { "field": { "circle_id": { "type": "STRING" } }, "min_length": 1, "max_length": 255 },
        { "field": { "user_id": { "type": "STRING" } }, "min_length": 1, "max_length": 255 },
        { "field": { "payout_position": { "type": "NUMBER" } } }
      ],
      "sql_query": {
        "query": "UPDATE _memberships SET payout_position = $3::int, updated_at = $4::timestamptz WHERE circle_id = $1 AND user_id = $2 AND EXISTS (SELECT 1 FROM _circles WHERE id = $1 AND owner_id = $5 AND status = 'PENDING') RETURNING id, user_id, payout_position",
        "parameters": ["$PAYLOAD.circle_id", "$PAYLOAD.user_id", "$PAYLOAD.payout_position", "$DATETIME", "$PROTECTED.id"]
      },
      "returnables": ["id", "user_id", "payout_position"],
      "main_returnable": true
    }
  ]
}
