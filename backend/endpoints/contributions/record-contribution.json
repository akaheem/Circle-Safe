{
  "id": "circlesafe-record-contribution-01",
  "resource": "record-contribution",
  "tokenize": { "type": "JWT", "algorithm": "HS256", "encryption_key": "$ENV.JWT_SECRET_KEY" },
  "protected": { "provide_as": "Authorization", "extract_claims": ["id"] },
  "rate_limit": { "limit": 30, "identifier": "$HEADER.ip", "expires_after": 60 },
  "actionables": [
    {
      "id": 1,
      "mode": "QUERY",
      "payload_validation": [
        { "field": { "circle_id": { "type": "STRING" } }, "min_length": 1, "max_length": 255 }
      ],
      "sql_query": {
        "query": "SELECT c.current_cycle, c.contribution_amount FROM _circles c JOIN _memberships m ON m.circle_id = c.id WHERE c.id = $1 AND m.user_id = $2 AND m.status = 'ACTIVE' AND c.status = 'ACTIVE'",
        "parameters": ["$PAYLOAD.circle_id", "$PROTECTED.id"]
      },
      "returnables": ["current_cycle", "contribution_amount"]
    },
    {
      "id": 2,
      "mode": "QUERY",
      "depends_on": [ { "resource_id": "self", "action_ids": [1], "extract_response_for": [ { "extract": "current_cycle", "for": "cycle" }, { "extract": "contribution_amount", "for": "amount" } ] } ],
      "sql_query": {
        "query": "INSERT INTO _contributions (id, circle_id, user_id, cycle, amount, status, created_at, updated_at) VALUES ($1, $2, $3, $4::int, $5::float8, 'PENDING', $6::timestamptz, $6::timestamptz) RETURNING id, cycle, amount, status",
        "parameters": ["$GENERATOR.KSUID", "$PAYLOAD.circle_id", "$PROTECTED.id", "cycle", "amount", "$DATETIME"]
      },
      "returnables": ["id", "cycle", "amount", "status"],
      "main_returnable": true,
      "broadcast_websocket_message": { "broadcast_type": "ALL", "action": "circle_update" }
    },
    {
      "id": 3,
      "mode": "QUERY",
      "sql_query": {
        "query": "INSERT INTO _activity (id, circle_id, actor_id, type, message, created_at) VALUES ($1, $2, $3, 'CONTRIBUTION_RECORDED', 'Contribution recorded (pending confirmation)', $4::timestamptz)",
        "parameters": ["$GENERATOR.KSUID", "$PAYLOAD.circle_id", "$PROTECTED.id", "$DATETIME"]
      }
    }
  ]
}
