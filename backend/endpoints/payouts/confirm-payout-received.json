{
  "id": "circlesafe-confirm-payout-received-01",
  "resource": "confirm-payout-received",
  "tokenize": { "type": "JWT", "algorithm": "HS256", "encryption_key": "$ENV.JWT_SECRET_KEY" },
  "protected": { "provide_as": "Authorization", "extract_claims": ["id"] },
  "actionables": [
    {
      "id": 1,
      "mode": "QUERY",
      "payload_validation": [
        { "field": { "payout_id": { "type": "STRING" } }, "min_length": 1, "max_length": 255 }
      ],
      "sql_query": {
        "query": "UPDATE _payouts SET status = 'RECEIVED', updated_at = $3::timestamptz WHERE id = $1 AND recipient_id = $2 AND status = 'PAID' RETURNING id, circle_id, status",
        "parameters": ["$PAYLOAD.payout_id", "$PROTECTED.id", "$DATETIME"]
      },
      "returnables": ["id", "circle_id", "status"],
      "main_returnable": true,
      "broadcast_websocket_message": { "broadcast_type": "ALL", "action": "circle_update" }
    },
    {
      "id": 2,
      "mode": "QUERY",
      "depends_on": [ { "resource_id": "self", "action_ids": [1], "extract_response_for": [ { "extract": "circle_id", "for": "circle_id" } ] } ],
      "sql_query": {
        "query": "INSERT INTO _activity (id, circle_id, actor_id, type, message, created_at) VALUES ($1, $2, $3, 'PAYOUT_CONFIRMED', 'Recipient confirmed payout received', $4::timestamptz)",
        "parameters": ["$GENERATOR.KSUID", "circle_id", "$PROTECTED.id", "$DATETIME"]
      }
    }
  ]
}
