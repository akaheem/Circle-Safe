{
  "id": "circlesafe-get-circle-01",
  "resource": "get-circle",
  "tokenize": { "type": "JWT", "algorithm": "HS256", "encryption_key": "$ENV.JWT_SECRET_KEY" },
  "protected": { "provide_as": "Authorization", "extract_claims": ["id"] },
  "actionables": [
    {
      "id": 1,
      "mode": "QUERY",
      "payload_validation": [
        { "field": { "circle_id": { "type": "STRING" } }, "min_length": 1, "max_length": 255 }
      ],
      "sql_query": {
        "query": "SELECT c.id, c.name, c.owner_id, c.contribution_amount, c.frequency, c.max_members, c.currency, c.status, c.current_cycle, c.rules, c.created_at FROM _circles c JOIN _memberships m ON m.circle_id = c.id WHERE c.id = $1 AND m.user_id = $2 AND m.deleted_at IS NULL AND c.deleted_at IS NULL",
        "parameters": ["$PAYLOAD.circle_id", "$PROTECTED.id"]
      },
      "returnables": ["id", "name", "owner_id", "contribution_amount", "frequency", "max_members", "currency", "status", "current_cycle", "rules", "created_at"],
      "main_returnable": true
    }
  ]
}
