{
  "id": "circlesafe-logout-01",
  "resource": "logout",
  "tokenize": {
    "type": "JWT",
    "algorithm": "HS256",
    "encryption_key": "$ENV.JWT_SECRET_KEY"
  },
  "protected": {
    "provide_as": "Authorization",
    "extract_claims": ["id"]
  },
  "invalidate_tokenize": {
    "tokens": "$PAYLOAD.tokens",
    "expires_after": 86400
  }
}
