{
  "id": {
    "type": "String",
    "max_length": 255,
    "primary_key": true
  },
  "name": {
    "type": "String",
    "max_length": 255,
    "fts": true,
    "indexable": true
  },
  "owner_id": {
    "type": "String",
    "max_length": 255,
    "indexable": true,
    "foreign_key": {
      "of": "_users",
      "key": "id"
    }
  },
  "contribution_amount": {
    "type": "Float"
  },
  "frequency": {
    "type": "String",
    "max_length": 20
  },
  "max_members": {
    "type": "Number"
  },
  "currency": {
    "type": "String",
    "max_length": 10
  },
  "status": {
    "type": "String",
    "max_length": 20
  },
  "current_cycle": {
    "type": "Number"
  },
  "rules": {
    "type": "JSON_OBJECT",
    "optional": true,
    "properties": {
      "grace_period_days": {
        "type": "Number",
        "optional": true
      },
      "late_fee": {
        "type": "Float",
        "optional": true
      }
    }
  },
  "created_at": {
    "type": "DateTime"
  },
  "updated_at": {
    "type": "DateTime"
  },
  "deleted_at": {
    "type": "DateTime",
    "optional": true
  }
}
